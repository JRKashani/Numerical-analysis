function [U, t, ] = RK45_solver(func, t_span, u0, para)
    
    eps = para.epsilon;
    hmax = para.hmax;
    
    
    t = zeros(ceil(t_span/hmax), 1);
    U = zeros(length(t), para.ode_rank);
    curr_step = 0;
    
    [A, err, b5, c] = RKF_Butcher_Tableau();
    solver_ks = 6;    

    rel_slopes = zeros(para.ode_rank, solver_ks);
    
    while (t(curr_step) < t_span)        
        for j = 1:solver_ks
            if j == 1
                temp_prob = uk;
            else
                temp_prob = uk+(h* (rel_slopes(:, 1:j-1) * A(j, 1:j-1).'));
            end
            rel_slopes(:, j) = func(t(curr_step) + c(j)*h, temp_prob);
        end
        u5 = uk + h * (rel_slopes * b5);
        u_err = uk + h * (rel_slopes * err);
        R = (1/h)*max(abs(u_err));
        if R <= eps
            U(curr_step + 1, :) = u5;
            curr_step = curr_step + 1;
            if curr_step > length(t)
                t = [t; zeros(1000, 1)];
                U = [U; zeros(1000, para.ode_rank)];
            end
        end
        delta = 0.841*(eps/R)^0.25; %The 0.84 is approx 0.5^0.25 and
        % reason for 0.25 is that the general error is of size O(h^4)
        if delta <= 0.1
            h = 0.1*h;
        elseif delta > 4
            h = 4*h;                
        else
            h = delta*h;
        end
        if h > hmax
            h = hmax;
        end
        t(curr_step) = t(curr_step - 1);
        rel_slopes(:,:) = 0;
    end

end