%% Tensile report plots: separate figures + trimming + metrics
% Files must be in working folder:
%   "first test 1045 full repot.txt"
%   "second test Al full report.txt"
%
% Columns (after header lines):
% Time (s) | Load (N) | Machine Extension (mm) | Stress (MPa) | Elongation (mm) | Percentage Elongation

clear; clc; close all;

files  = { "first test 1045 full repot.txt", "second test Al full report.txt" };
labels = { "SAE-1045", "Aluminum 6061" };

% ---------- User-tunable parameters ----------
trimEpsilonTol    = 1e-6;   % tolerance for detecting non-increasing strain (robust to tiny noise)
initialMaxStrain  = 0.002;  % use data up to this strain for initial linear fit attempt (e.g., 0.2%)
minPointsForFit   = 50;     % minimum points required in the initial region
linDevThreshold   = 0.005;  % relative deviation threshold to mark end of linear region (0.5%)
smoothWindow      = 0;      % 0 = no smoothing; else e.g., 21 for moving average window (odd)
% --------------------------------------------

for i = 1:numel(files)
    fn = files{i};
    if ~isfile(fn)
        error('File not found in working folder: %s', fn);
    end

    % Robust import: auto-skip nonnumeric header and handle multiple delimiters
    opts = detectImportOptions(fn, ...
        'FileType','text', ...
        'Delimiter', {'\t',' ',';',' ,'}, ...
        'MultipleDelimsAsOne', true);

    varNames = string(opts.VariableNames);
    colStress = find(contains(lower(varNames), "stress"), 1);
    colPercEl = find(contains(lower(varNames), "percentage") & contains(lower(varNames), "elong"), 1);

    if isempty(colStress); colStress = 4; end
    if isempty(colPercEl); colPercEl = 6; end

    opts.SelectedVariableNames = opts.VariableNames([colStress, colPercEl]);
    T = readtable(fn, opts);

    stress = double(T{:,1});  % MPa
    percEl = double(T{:,2});  % %

    % Clean
    ok = isfinite(stress) & isfinite(percEl);
    stress = stress(ok);
    percEl = percEl(ok);

    % Engineering strain
    strain = percEl / 100;

    % Optional smoothing (sometimes helps with noisy tails)
    if smoothWindow > 1
        strain_sm = movmean(strain, smoothWindow);
        stress_sm = movmean(stress, smoothWindow);
    else
        strain_sm = strain;
        stress_sm = stress;
    end

    % Shift strain to start at 0 (common when slight negatives exist)
    strain0 = strain_sm(1);
    strain_sm = strain_sm - strain0;

    % ---------- Trim tail where strain decreases ----------
    % Keep data up to the last index of the cumulative maximum strain.
    cumMax = cummax(strain_sm);
    [~, idxTrim] = max(cumMax); % last point reaching the global max (monotonic-increasing envelope)
    % Additional safety: if max at the end, no trim. If noise creates micro-decreases, this still works.

    strain_use = strain_sm(1:idxTrim);
    stress_use = stress_sm(1:idxTrim);

    % Ensure monotonic-ish strain for integration/analysis:
    % remove any remaining local decreases beyond tolerance
    dEps = diff(strain_use);
    keep = [true; dEps >= -trimEpsilonTol];
    strain_use = strain_use(keep);
    stress_use = stress_use(keep);

    % ---------- Find peak stress ----------
    [sigmaMax, idxMax] = max(stress_use);
    epsAtMax = strain_use(idxMax);

    % ---------- Initial linear fit (Young's modulus estimate) ----------
    idxInit = find(strain_use <= initialMaxStrain);
    if numel(idxInit) < minPointsForFit
        % fallback: take first N points
        idxInit = 1:min(minPointsForFit, numel(strain_use));
    end

    p = polyfit(strain_use(idxInit), stress_use(idxInit), 1); % stress = E*strain + b
    E_est = p(1);  % MPa (since stress in MPa, strain dimensionless)
    b_est = p(2);
    
    % ---------- 0.2% Offset Yield (Proof Stress) ----------
offset = 0.002;  % 0.2% engineering strain offset

% Offset line: sigma = E*(eps - offset) + b
sigma_offset_line = E_est .* (strain_use - offset) + b_est;

% Find first intersection where measured stress exceeds offset line
diffY = stress_use - sigma_offset_line;

% We want a sign change from negative to positive (crossing)
idxY = find(diffY(1:end-1) < 0 & diffY(2:end) >= 0, 1, 'first');

if isempty(idxY)
    % Fallback: choose the closest point (least absolute difference)
    [~, idxY] = min(abs(diffY));
    epsY = strain_use(idxY);
    sigmaY = stress_use(idxY);
else
    % Linear interpolation for more accurate crossing
    x1 = strain_use(idxY);     x2 = strain_use(idxY+1);
    y1 = diffY(idxY);          y2 = diffY(idxY+1);

    epsY = x1 - y1 * (x2 - x1) / (y2 - y1); % root of diffY between x1,x2
    sigmaY = interp1(strain_use([idxY idxY+1]), stress_use([idxY idxY+1]), epsY, 'linear');
end

    % ---------- End of linear region ----------
    % Compute predicted stress and find first point where relative deviation exceeds threshold
    sigma_pred = polyval(p, strain_use);
    relDev = abs(stress_use - sigma_pred) ./ max(abs(sigma_pred), 1e-9);

    % Search only after a small strain to avoid numerical issues near 0
    startSearch = find(strain_use >= 5e-4, 1, 'first');
    if isempty(startSearch); startSearch = 1; end

    idxEndLin = find(relDev(startSearch:end) > linDevThreshold, 1, 'first');
    if isempty(idxEndLin)
        idxEndLin = numel(strain_use);
    else
        idxEndLin = idxEndLin + startSearch - 1;
    end

    epsEndLin   = strain_use(idxEndLin);
    sigmaEndLin = stress_use(idxEndLin);

    % ---------- Area under curve ----------
    % Integral of stress d(strain) => energy density.
    areaUnder = trapz(strain_use, stress_use); % MPa = MJ/m^3

    % ---------- Plot (separate figure) ----------
    figure('Color','w');
    hold on; grid on;

    plot(strain_use, stress_use, 'LineWidth', 1.5);

    % Overlay initial fit line over the initial region
    strainFitLine = linspace(0, epsEndLin, 200)';
    stressFitLine = polyval(p, strainFitLine);
    plot(strainFitLine, stressFitLine, '--', 'LineWidth', 1.2);

    % Mark end of linear region and peak stress
    plot(epsEndLin, sigmaEndLin, 'o', 'MarkerSize', 7, 'LineWidth', 1.5);
    plot(epsAtMax,  sigmaMax,    's', 'MarkerSize', 7, 'LineWidth', 1.5);

    xlabel('Engineering Strain, \epsilon (–)');
    ylabel('Engineering Stress, \sigma (MPa)');
    title(sprintf('Stress–Strain (Engineering) — %s', labels{i}));

    legend({ 'Data (trimmed)', 'Initial linear fit', 'End of linear region', 'Peak stress' }, ...
        'Location', 'best');

    xlim([0, max(strain_use)*1.02]);
    ylim([0, max(stress_use)*1.05]);

    % Annotation box (values)
    txt = sprintf([ ...
        '%s\n' ...
        'Trim: kept up to max strain, then removed decreasing-strain points\n' ...
        'E (initial slope) = %.1f MPa = %.3f GPa\n' ...
        'End of linear region: \\epsilon = %.6f, \\sigma = %.2f MPa\n' ...
        'Peak stress: \\epsilon = %.6f, \\sigma_{max} = %.2f MPa\n' ...
        'Area \\int\\sigma d\\epsilon = %.2f MPa (≈ %.2f MJ/m^3)\n'], ...
        labels{i}, E_est, E_est/1000, epsEndLin, sigmaEndLin, epsAtMax, sigmaMax, areaUnder, areaUnder);

    text(0.02, 0.98, txt, 'Units','normalized', ...
        'VerticalAlignment','top', 'FontSize', 9, 'BackgroundColor','w');

    hold off;

    % Also print concise results to Command Window
    fprintf('\n=== %s ===\n', labels{i});
    fprintf('E_est = %.1f MPa (%.3f GPa)\n', E_est, E_est/1000);
    fprintf('End linear: eps=%.6f, sigma=%.2f MPa\n', epsEndLin, sigmaEndLin);
    fprintf('Peak: eps=%.6f, sigma_max=%.2f MPa\n', epsAtMax, sigmaMax);
    fprintf('Area = %.2f MPa (~%.2f MJ/m^3)\n', areaUnder, areaUnder);
end
